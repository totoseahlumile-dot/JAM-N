# Copy this file to .env and fill in your real sandbox credentials.
# NEVER commit the real .env file to git.

PAYFAST_MERCHANT_ID=10054735
PAYFAST_MERCHANT_KEY=your_merchant_key_here
PAYFAST_PASSPHRASE=your_passphrase_here

# Sandbox URL — switch to https://www.payfast.co.za/eng/process for live later
PAYFAST_URL=https://sandbox.payfast.co.za/eng/process

# Where PayFast should send buyers back to on your frontend
FRONTEND_RETURN_URL=http://localhost:5173/payment/success
FRONTEND_CANCEL_URL=http://localhost:5173/payment/cancel

# Where PayFast's servers POST the ITN — must be a PUBLIC url (ngrok etc) once you test real ITNs.
# For local dev before you have ngrok running, you can leave this pointing at localhost;
# PayFast just won't be able to reach it, so the ITN step will silently fail until you tunnel it.
NOTIFY_URL=http://localhost:4000/api/payment/notify

PORT=4000
